# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 超级管理员（Telegram user_id，多个用逗号分隔）
SUPER_ADMINS=123456789

# 赌博签到范围
GAMBLE_SIGN_MIN=-999
GAMBLE_SIGN_MAX=30

# 结婚消耗积分
MARRY_COST=500

# 下注上限（0为不限制）
DEFAULT_BET_LIMIT=0

# 游戏服务器地址（2048等H5游戏，填服务器的公网地址）
# 如果服务器IP是 1.2.3.4，则填 http://1.2.3.4:8080
# 如果有域名，可以填 http://game.example.com
# 本地开发用 http://localhost:8080 即可
GAME_BASE_URL=http://localhost:8080
